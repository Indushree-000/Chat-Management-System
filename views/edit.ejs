<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <p>Edit Chat: <%= chat._id %> </p>
    <p>This Chat was sent by <b><%= chat.from %></b> to <b><%= chat.to %></b></p>
    
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" rows="8" cols="40"><%= chat.msg %></textarea><br>
        <button>Edit Chat</button>
    </form>
</body>
</html>